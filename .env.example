# Copy to .env and fill in your secrets — .env is gitignored.
# Taskfile loads .env automatically (see Taskfile.yml `dotenv`).

# ── Embeddings ─────────────────────────────────────────────────────────
# Local TEI (default, no key needed):
# MEM_EMBED_URL=http://localhost:3000
# MEM_EMBED_MODEL=BAAI/bge-base-en-v1.5
# Hosted (OpenAI, Cohere, Voyage, …):
# MEM_EMBED_URL=https://api.openai.com/v1
# MEM_EMBED_MODEL=text-embedding-3-small
# MEM_EMBED_API_KEY=sk-...

# ── Extraction (chat model for fact proposals) ─────────────────────────
# Any OpenAI-compatible /v1 endpoint. Enabled only when explicitly set:
# MEM_EXTRACT_ENABLED=true
# MEM_EXTRACT_BASE_URL=https://api.openai.com/v1
# MEM_EXTRACT_MODEL=gpt-4o-mini
# MEM_EXTRACT_API_KEY=sk-...

# ── Storage (override dev defaults only if needed) ─────────────────────
# MEM_CH_ADDR=localhost:9000
# MEM_CH_PASSWORD=memdev
# MEM_DGRAPH_ADDR=localhost:9080

# ── Observability ────────────────────────────────────────────────────────
# MEM_LOG_LEVEL=debug  # info (default), debug, warn, error — debug shows per-observation extraction decisions

# ── MCP remote tokens (when running memmcp in HTTP mode) ───────────────
# MEM_MCP_HTTP_ADDR=127.0.0.1:18443
# MEM_MCP_TOKENS_FILE=/path/to/tokens.json
